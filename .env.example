# Copy to .env.local and fill in. Every value is optional: with an empty file
# the template runs against mock auth and mock billing.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute base URL Stripe redirects back to after Checkout and the portal,
# and the canonical origin for SEO: canonical links, Open Graph URLs, the
# sitemap, robots.txt, llms.txt, and structured data. Must be the deployed
# origin in production. On Vercel it falls back to the production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
# "on" or "off". Unset: only Vercel production deployments (or production
# builds outside Vercel) can be indexed; previews send noindex everywhere and
# robots.txt disallows all. Set "off" on a self-hosted staging environment.
SITE_INDEXING=

# Search console ownership tokens: the content value of each verification
# meta tag, not the whole tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
# "mock" (default) or "stripe". Switching to "stripe" makes /plans and the
# billing portal call the real API instead of the in-memory mock.
NEXT_PUBLIC_BILLING_PROVIDER=mock

# Stripe secret key. Test mode keys start with sk_test_.
STRIPE_SECRET_KEY=

# Signing secret for /api/billing/webhook. Locally, `stripe listen` prints one;
# in production it comes from the endpoint you create in the dashboard.
STRIPE_WEBHOOK_SECRET=

# Recurring price IDs (price_...), one per plan in `plans` in
# src/lib/template-data.ts. Test mode and live mode have different IDs.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# The Scale plan is sales-led in the template, so it needs no price ID until
# it becomes self-serve.
STRIPE_PRICE_SCALE=
